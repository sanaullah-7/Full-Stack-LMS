{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["off"],
    "linebreak-style": ["off"],
    "quotes": ["off"],
    "semi": ["off"],
    "no-unused-vars": "warn"
  }
}
